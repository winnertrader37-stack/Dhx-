<!DOCTYPE html><html lang="om"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>Naol Studio</title><style>
:root{--bg:#111318;--p:#1b1e26;--l:#2b303b;--t:#e8eaf0;--m:#8b93a5;--a:#22d3b6;--r:#ff5468;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:light){:root{--bg:#f3f4f7;--p:#fff;--l:#dfe3ea;--t:#171a21;--m:#5d6676;--a:#0a9e88;--r:#d92d45;color-scheme:light}}
*{box-sizing:border-box}html,body{height:100%;margin:0;background:var(--bg);color:var(--t);font:13px system-ui,sans-serif}
body{display:flex;flex-direction:column}button,select,input{font:inherit;color:inherit}
#tb{display:flex;flex-wrap:wrap;gap:6px;align-items:center;padding:8px 10px;background:var(--p)}
.b{background:var(--l);border:0;border-radius:8px;padding:8px 11px;font-size:15px}.b.on{background:var(--a);color:#001}.b.r{background:var(--r);color:#fff}
#tm{font:600 16px ui-monospace,monospace;min-width:62px}
#tb input[type=number],#tb select{background:var(--l);border:0;border-radius:6px;padding:6px;width:58px}
#lv{height:16px;margin:6px 10px 0;background:var(--l);border-radius:8px;position:relative;overflow:hidden}#lvb{position:absolute;inset:0 auto 0 0;background:var(--a);width:0}#lvt{position:absolute;inset:0;text-align:center;font-size:11px;line-height:16px}
#wr{flex:1;min-height:90px;overflow:auto;margin:6px 0;background:var(--p)}
#nav{display:flex;overflow-x:auto;background:var(--p)}#nav button{flex:none;background:none;border:0;padding:10px 14px;color:var(--m)}#nav .on{color:var(--a);border-bottom:2px solid var(--a)}
#pn{height:38vh;overflow:auto;padding:10px 12px;background:var(--p);border-top:1px solid var(--l)}
.s{display:flex;align-items:center;gap:8px;margin:2px 0;color:var(--m)}.s span{width:96px;flex:none}.s input{flex:1;min-width:0}.s b{width:64px;text-align:right;color:var(--t);font-weight:500}
.pb{background:var(--l);border:0;border-radius:8px;padding:9px 12px;margin:3px 4px 3px 0}.pb.p{background:var(--a);color:#001;font-weight:700}
.tr{display:grid;grid-template-columns:70px 1fr 1fr 34px 34px;gap:6px;align-items:center;margin:4px 0}.tr.sel{outline:1px solid var(--a);border-radius:6px}.tr .pb{margin:0;padding:6px}
.n{color:var(--m);font-size:11px;margin:6px 0}.q{background:var(--l);border:0;border-radius:6px;padding:7px;margin:3px 4px 3px 0}
#ts{position:fixed;left:50%;bottom:44vh;transform:translateX(-50%);background:#000d;color:#fff;padding:8px 14px;border-radius:20px;display:none;max-width:90%;text-align:center;z-index:9}
</style></head><body>
<div id="tb"><button class="b" id="rw">⏮</button><button class="b" id="pl">▶</button><button class="b r" id="rc">⏺</button><button class="b" id="pa">⏸</button><button class="b" id="sp">⏹</button><span id="tm">0:00.0</span>BPM<input type="number" id="bpm" value="120" min="40" max="240"><select id="sig"><option value="4">4/4</option><option value="3">3/4</option><option value="6">6/8</option></select><button class="b" id="mt" title="Metronome">🥁</button><button class="b" id="ad" title="Add track">＋</button><button class="b" id="im" title="Import beat/audio">⤒</button></div>
<div id="lv"><i id="lvb"></i><span id="lvt"></span></div>
<div id="wr"><canvas id="cv"></canvas></div><div id="nav"></div><div id="pn"></div><div id="ts"></div>
<input type="file" id="fi" accept="audio/*" multiple hidden><input type="file" id="fr" accept="audio/*" hidden>
<script>
const $=s=>document.querySelector(s),AC=new(window.AudioContext||window.webkitAudioContext)(),cv=$('#cv'),q=cv.getContext('2d'),wr=$('#wr'),pn=$('#pn');
const DV=[['1/4',1],['1/8',.5],['1/8 dotted',.75],['1/16',.25]],RVT=[['Room',.7,3],['Studio',1.1,3],['Plate',2,2],['Hall',3.2,2]],TABS=['Mixer','Track','Clip','Master','Analyze','Project'],RH=58,RU=20;
const mkT=()=>({n:'Track '+(S.tr.length+1),vol:.8,pan:0,m:0,so:0,cl:[],eq:[0,0,0],cm:0,des:0,sat:0,ch:0,rv:0,dl:0,au:[]});
const S={bpm:120,sig:4,tr:[],sel:0,ph:0,px:60,ab:0,met:0,mon:0,lat:0,xsr:44100,bits:16,fmt:'wav',kb:192,ref:null,mt:{lo:0,hi:0,cm:0,wd:1,lim:-1,dv:1,fb:.35,rt:1}};S.tr.push(mkT());
let clip=null,N=null,playing=0,t0=0,tAt=0,rec=null,uid=1,tab=0,CB=null,pc=100,ps=0,th=-45,mb=0,ls=0,pkMax=0,hold=0,dg=null;
const fmt=t=>Math.floor(t/60)+':'+(t%60).toFixed(1).padStart(4,'0'),dur=()=>Math.max(10,...S.tr.flatMap(t=>t.cl.map(c=>c.st+c.dur)));
function toast(m,ms=2500){const t=$('#ts');t.textContent=m;t.style.display='block';clearTimeout(toast.h);toast.h=setTimeout(()=>t.style.display='none',ms)}
/* ---------- audio graph (live + offline share it) ---------- */
function build(c,t0,o={}){const b=o.base??c.currentTime,g=()=>c.createGain(),f=(t,fr,Q)=>{const n=c.createBiquadFilter();n.type=t;n.frequency.value=fr;if(Q)n.Q.value=Q;return n},K=()=>c.createDynamicsCompressor();
 const M={src:[],osc:[],o,mix:g(),out:g(),lo:f('lowshelf',120),hi:f('highshelf',8000),cm:K(),lim:K(),sp:c.createChannelSplitter(2),mg:c.createChannelMerger(2),w:[g(),g(),g(),g()],rv:c.createConvolver(),rvg:g(),dl:c.createDelay(2),dlf:g(),dlg:g(),tr:[]};
 M.lim.knee.value=0;M.lim.attack.value=.002;M.lim.ratio.value=20;
 const[,rs,rd]=RVT[S.mt.rt],L=Math.floor(c.sampleRate*rs),ir=c.createBuffer(2,L,c.sampleRate);for(let k=0;k<2;k++){const d=ir.getChannelData(k);for(let i=0;i<L;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/L,rd)}M.rv.buffer=ir;
 if(o.nm)M.mix.connect(M.out);else{M.mix.connect(M.lo);M.lo.connect(M.hi);M.hi.connect(M.cm);M.cm.connect(M.sp);M.sp.connect(M.w[0],0);M.sp.connect(M.w[2],0);M.sp.connect(M.w[1],1);M.sp.connect(M.w[3],1);M.w[0].connect(M.mg,0,0);M.w[1].connect(M.mg,0,0);M.w[2].connect(M.mg,0,1);M.w[3].connect(M.mg,0,1);M.mg.connect(M.lim);M.lim.connect(M.out)}
 M.rv.connect(M.rvg);M.rvg.connect(M.mix);M.dl.connect(M.dlf);M.dlf.connect(M.dl);M.dl.connect(M.dlg);M.dlg.connect(M.mix);M.out.connect(c.destination);
 if(!o.off){M.an=c.createAnalyser();M.an.fftSize=2048;M.an.smoothingTimeConstant=.8;M.s2=c.createChannelSplitter(2);M.aL=c.createAnalyser();M.aR=c.createAnalyser();M.aL.fftSize=M.aR.fftSize=1024;M.out.connect(M.an);M.out.connect(M.s2);M.s2.connect(M.aL,0);M.s2.connect(M.aR,1);M.fl=new Float32Array(1024);M.fr=new Float32Array(1024);M.fb=new Uint8Array(1024)}
 S.tr.forEach((t,i)=>{if(o.only!=null&&o.only!=i)return;const T={t,in:g(),eq:[f('lowshelf',200),f('peaking',1200,1),f('highshelf',5000)],cm:K(),sat:c.createWaveShaper(),des:f('peaking',6500,3),cd:c.createDelay(.1),cg:g(),vg:g(),pn:c.createStereoPanner(),mu:g(),sr:g(),sd:g(),lf:c.createOscillator(),lg:g()};
  T.in.connect(T.eq[0]);T.eq[0].connect(T.eq[1]);T.eq[1].connect(T.eq[2]);T.eq[2].connect(T.cm);T.cm.connect(T.sat);T.sat.connect(T.des);T.des.connect(T.vg);T.des.connect(T.cd);T.cd.connect(T.cg);T.cg.connect(T.vg);T.vg.connect(T.pn);T.pn.connect(T.mu);T.mu.connect(M.mix);T.mu.connect(T.sr);T.sr.connect(M.rv);T.mu.connect(T.sd);T.sd.connect(M.dl);
  T.cd.delayTime.value=.022;T.lf.frequency.value=.8;T.lg.gain.value=.004;T.lf.connect(T.lg);T.lg.connect(T.cd.delayTime);T.lf.start();M.osc.push(T.lf);
  if(t.au.length){const a=[...t.au].sort((x,y)=>x.t-y.t),ip=u=>{if(u<=a[0].t)return a[0].v;for(let k=1;k<a.length;k++)if(u<=a[k].t)return a[k-1].v+(a[k].v-a[k-1].v)*(u-a[k-1].t)/((a[k].t-a[k-1].t)||1);return a[a.length-1].v};T.vg.gain.setValueAtTime(ip(t0),b);a.forEach(p=>{if(p.t>t0)T.vg.gain.linearRampToValueAtTime(p.v,b+p.t-t0)})}
  t.cl.forEach(cl=>{if(cl.m)return;const sk=Math.max(0,t0-cl.st),d=cl.dur-sk;if(d<=.005)return;const s=c.createBufferSource(),cg=g();s.buffer=cl.buf;s.connect(cg);cg.connect(T.in);const w=b+Math.max(0,cl.st-t0),a0=cl.fi>0?Math.min(1,sk/cl.fi):1;cg.gain.setValueAtTime(a0,w);let last=w;
   if(cl.fi>0&&sk<cl.fi){last=w+cl.fi-sk;cg.gain.linearRampToValueAtTime(1,last)}
   if(cl.fo>0){const e=w+d,fs=Math.max(last,e-cl.fo);cg.gain.setValueAtTime(1,fs);cg.gain.linearRampToValueAtTime(0,e)}
   s.start(w,cl.off+sk,d);M.src.push(s)});M.tr.push(T)});
 if(S.ref&&!o.off){const rs=c.createBufferSource(),rg=g();rs.buffer=S.ref;rs.connect(rg);rg.connect(M.out);M.rg=rg;if(t0<S.ref.duration){rs.start(b,t0);M.src.push(rs)}}
 upd(M);return M}
function upd(M){if(!M)return;const m=S.mt,a=(1+m.wd)/2,z=(1-m.wd)/2;M.lo.gain.value=m.lo;M.hi.gain.value=m.hi;M.cm.threshold.value=-m.cm*3;M.cm.ratio.value=m.cm?1+m.cm*.8:1;M.lim.threshold.value=m.lim;M.w[0].gain.value=M.w[3].gain.value=a;M.w[1].gain.value=M.w[2].gain.value=z;M.dl.delayTime.value=Math.min(1.9,60/S.bpm*DV[m.dv][1]);M.dlf.gain.value=m.fb;M.dlg.gain.value=1;M.rvg.gain.value=1;M.mix.gain.value=S.ab&&M.rg?0:1;if(M.rg)M.rg.gain.value=S.ab?1:0;
 const any=S.tr.some(x=>x.so);M.tr.forEach(T=>{const t=T.t;T.eq.forEach((e,k)=>e.gain.value=t.eq[k]);T.cm.threshold.value=-t.cm*3;T.cm.ratio.value=t.cm?1+t.cm*1.2:1;T.des.gain.value=-t.des;T.cg.gain.value=t.ch;T.pn.pan.value=t.pan;T.mu.gain.value=!M.o.nm&&(t.m||(any&&!t.so))?0:1;T.sr.gain.value=t.rv;T.sd.gain.value=t.dl;if(!t.au.length)T.vg.gain.value=t.vol;if(T.sk!==t.sat){T.sk=t.sat;const d=1+t.sat*8;T.sat.curve=t.sat?Float32Array.from({length:1024},(_,i)=>Math.tanh((i/512-1)*d)/Math.tanh(d)):null}})}
function play(from){AC.resume();stop();if(from!=null)S.ph=from;t0=S.ph;const base=AC.currentTime+.06;N=build(AC,t0,{base});tAt=base;playing=1;pkMax=0;mb=Math.ceil(t0/(60/S.bpm)-1e-6);$('#pl').textContent='⏸';$('#pl').classList.add('on')}
function stop(){if(N){N.src.forEach(s=>{try{s.stop()}catch(e){}});N.osc.forEach(o=>{try{o.stop()}catch(e){}});try{N.out.disconnect()}catch(e){}}N=null;playing=0;$('#pl').textContent='▶';$('#pl').classList.remove('on')}
setInterval(()=>{if(!playing||!S.met)return;const spb=60/S.bpm;for(;;){const tt=tAt+mb*spb-t0;if(tt>AC.currentTime+.12)break;if(tt>=AC.currentTime-.02){const o=AC.createOscillator(),g=AC.createGain();o.frequency.value=mb%S.sig?900:1500;g.gain.setValueAtTime(.3,tt);g.gain.exponentialRampToValueAtTime(.001,tt+.05);o.connect(g);g.connect(AC.destination);o.start(tt);o.stop(tt+.06)}mb++}},25);
/* ---------- recording ---------- */
async function recGo(){if(rec){if(rec.r.state=='recording'){rec.r.pause();stop();$('#pa').classList.add('on')}else{rec.r.resume();play();$('#pa').classList.remove('on')}return}
 let st;try{st=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:false,noiseSuppression:false,autoGainControl:false}})}catch(e){return toast('Mic hayyamni hin argamne')}
 AC.resume();const src=AC.createMediaStreamSource(st),an=AC.createAnalyser();an.fftSize=1024;src.connect(an);let mg=null;if(S.mon){mg=AC.createGain();src.connect(mg);mg.connect(AC.destination)}
 const r=new MediaRecorder(st),ch=[],tri=S.sel,at=S.ph;rec={r,an,fl:new Float32Array(1024)};r.ondataavailable=e=>e.data.size&&ch.push(e.data);
 r.onstop=async()=>{st.getTracks().forEach(x=>x.stop());src.disconnect();try{mg&&mg.disconnect()}catch(e){}rec=null;$('#rc').classList.remove('on');$('#pa').classList.remove('on');
  try{const buf=await AC.decodeAudioData(await new Blob(ch).arrayBuffer()),s0=Math.max(0,at-S.lat/1000),T=S.tr[tri];if(!T)return;T.cl.forEach(c=>{if(c.tk&&c.st<s0+buf.duration&&c.st+c.dur>s0)c.m=1});const c={id:uid++,buf,st:s0,off:0,dur:buf.duration,fi:0,fo:0,m:0,tk:1};T.cl.push(c);clip=c;toast('Take dabalameera ✔');P()}catch(e){toast('Decode hin danda’amne')}};
 r.start();$('#rc').classList.add('on');play()}
const recStop=()=>{if(rec&&rec.r.state!='inactive')rec.r.stop()};
async function imp(files,ref){for(const f of files){try{const buf=await AC.decodeAudioData(await f.arrayBuffer());if(ref){S.ref=buf;toast('Reference galfameera ✔')}else{const T=S.tr[S.sel],c={id:uid++,buf,st:S.ph,off:0,dur:buf.duration,fi:0,fo:0,m:0};T.cl.push(c);clip=c}}catch(e){toast('Faayilii kun hin dubbifamne')}}P()}
/* ---------- editing & DSP ---------- */
const cur=()=>S.tr.find(t=>t.cl.includes(clip));
function split(){const t=cur();if(!clip||S.ph<=clip.st+.02||S.ph>=clip.st+clip.dur-.02)return toast('Playhead clip keessa kaa’i');const d=S.ph-clip.st,n={...clip,id:uid++,st:S.ph,off:clip.off+d,dur:clip.dur-d,fi:0};clip.dur=d;clip.fo=0;t.cl.push(n);clip=n;P()}
function paste(at){if(!CB)return;const c={...CB,id:uid++,st:at??S.ph};S.tr[S.sel].cl.push(c);clip=c;P()}
function del(){const t=cur();if(t){t.cl.splice(t.cl.indexOf(clip),1);clip=null;P()}}
const slice=c=>{const b=c.buf,sr=b.sampleRate,a=Math.floor(c.off*sr),n=Math.max(1,Math.floor(c.dur*sr)),o=AC.createBuffer(b.numberOfChannels,n,sr);for(let k=0;k<b.numberOfChannels;k++)o.copyToChannel(b.getChannelData(k).subarray(a,a+n),k);return o};
const setB=b=>{clip.buf=b;clip.off=0;clip.dur=b.duration;P()},pr=f=>{toast('Hojjachaa jira…');setTimeout(()=>{try{setB(f())}catch(e){toast('Dogoggora')}},30)};
function norm(b){let m=0;for(let k=0;k<b.numberOfChannels;k++){const x=b.getChannelData(k);for(let i=0;i<x.length;i++)m=Math.max(m,Math.abs(x[i]))}const g=m?.89/m;for(let k=0;k<b.numberOfChannels;k++){const x=b.getChannelData(k);for(let i=0;i<x.length;i++)x[i]*=g}return b}
function stretch(b,r){const G=2048,Ho=512,Hi=Ho/r,n=Math.floor(b.length*r),o=AC.createBuffer(b.numberOfChannels,n,b.sampleRate);for(let c=0;c<b.numberOfChannels;c++){const x=b.getChannelData(c),y=o.getChannelData(c),w=new Float32Array(n+G);for(let k=0;;k++){const oi=k*Ho,ii=Math.floor(k*Hi);if(oi>=n||ii>=x.length)break;for(let i=0;i<G;i++){const h=.5-.5*Math.cos(2*Math.PI*i/G);if(oi+i<n){y[oi+i]+=(ii+i<x.length?x[ii+i]:0)*h;w[oi+i]+=h}}}for(let i=0;i<n;i++)if(w[i]>1e-3)y[i]/=w[i]}return o}
function resample(b,f){const n=Math.floor(b.length/f),o=AC.createBuffer(b.numberOfChannels,n,b.sampleRate);for(let c=0;c<b.numberOfChannels;c++){const x=b.getChannelData(c),y=o.getChannelData(c);for(let i=0;i<n;i++){const p=i*f,a=Math.floor(p);y[i]=x[a]+((x[a+1]??x[a])-x[a])*(p-a)}}return o}
const pitchS=(b,s)=>{const f=Math.pow(2,s/12);return resample(stretch(b,f),f)};
function clean(b,thr,rm){const F=441,n=Math.ceil(b.length/F),T=Math.pow(10,thr/20),on=new Uint8Array(n),ch=b.numberOfChannels;for(let f=0;f<n;f++){let s=0,c=0;for(let k=0;k<ch;k++){const x=b.getChannelData(k);for(let i=f*F;i<Math.min(b.length,f*F+F);i++){s+=x[i]*x[i];c++}}on[f]=Math.sqrt(s/c)>T?1:0}
 const op=on.map((v,f)=>{for(let j=f-4;j<=f+4;j++)if(on[j])return 1;return 0});
 if(rm){for(let i=0;i<n;){if(!op[i]){let j=i;while(j<n&&!op[j])j++;if(j-i<20)for(let z=i;z<j;z++)op[z]=1;i=j}else i++}let keep=0;op.forEach(v=>keep+=v);if(!keep)return b;const o=AC.createBuffer(ch,keep*F,b.sampleRate);for(let k=0;k<ch;k++){const x=b.getChannelData(k),y=o.getChannelData(k);let p=0;for(let f=0;f<n;f++)if(op[f])for(let i=f*F;i<Math.min(b.length,f*F+F)&&p<y.length;i++)y[p++]=x[i]}return o}
 const o=AC.createBuffer(ch,b.length,b.sampleRate);for(let k=0;k<ch;k++){const x=b.getChannelData(k),y=o.getChannelData(k);let g=1;for(let i=0;i<x.length;i++){g+=((op[Math.floor(i/F)]?1:.03)-g)*.004;y[i]=x[i]*g}}return o}
/* ---------- export: WAV / MP3 inside ZIP (viewer save list allows zip) ---------- */
function wav(b,bits){const n=b.length,ch=b.numberOfChannels,by=bits/8,buf=new ArrayBuffer(44+n*ch*by),d=new DataView(buf),w=(o,s)=>[...s].forEach((c,i)=>d.setUint8(o+i,c.charCodeAt(0)));w(0,'RIFF');d.setUint32(4,36+n*ch*by,1);w(8,'WAVEfmt ');d.setUint32(16,16,1);d.setUint16(20,1,1);d.setUint16(22,ch,1);d.setUint32(24,b.sampleRate,1);d.setUint32(28,b.sampleRate*ch*by,1);d.setUint16(32,ch*by,1);d.setUint16(34,bits,1);w(36,'data');d.setUint32(40,n*ch*by,1);let o=44;const D=[...Array(ch).keys()].map(k=>b.getChannelData(k));
 for(let i=0;i<n;i++)for(let k=0;k<ch;k++){const x=Math.max(-1,Math.min(1,D[k][i]));if(bits==16)d.setInt16(o,x<0?x*32768:x*32767,1);else{const v=Math.round(x<0?x*8388608:x*8388607);d.setUint8(o,v&255);d.setUint8(o+1,(v>>8)&255);d.setUint8(o+2,(v>>16)&255)}o+=by}return new Blob([buf])}
async function mp3(b,kb){if(!window.lamejs)await new Promise((r,j)=>{const s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/lamejs/1.2.1/lame.min.js';s.onload=r;s.onerror=()=>j(new Error('MP3 encoder hin fe’amne'));document.head.append(s)});const e=new lamejs.Mp3Encoder(2,b.sampleRate,kb),i16=x=>Int16Array.from(x,v=>{v=Math.max(-1,Math.min(1,v));return v<0?v*32768:v*32767}),l=i16(b.getChannelData(0)),r=i16(b.getChannelData(1)),out=[];for(let i=0;i<l.length;i+=1152){const k=e.encodeBuffer(l.subarray(i,i+1152),r.subarray(i,i+1152));if(k.length)out.push(k)}out.push(e.flush());return new Blob(out)}
const crcT=(()=>{const t=[];for(let n=0;n<256;n++){let c=n;for(let k=0;k<8;k++)c=c&1?0xEDB88320^(c>>>1):c>>>1;t[n]=c>>>0}return t})(),crc=u=>{let c=-1;for(let i=0;i<u.length;i++)c=crcT[(c^u[i])&255]^(c>>>8);return(c^-1)>>>0};
async function zip(fs){const P=[],C=[],te=new TextEncoder();let o=0;for(const f of fs){const d=new Uint8Array(await f.b.arrayBuffer()),n=te.encode(f.n),c=crc(d),h=new DataView(new ArrayBuffer(30)),e=new DataView(new ArrayBuffer(46));h.setUint32(0,0x04034b50,1);h.setUint16(4,20,1);h.setUint32(14,c,1);h.setUint32(18,d.length,1);h.setUint32(22,d.length,1);h.setUint16(26,n.length,1);P.push(h,n,d);
 e.setUint32(0,0x02014b50,1);e.setUint16(4,20,1);e.setUint16(6,20,1);e.setUint32(16,c,1);e.setUint32(20,d.length,1);e.setUint32(24,d.length,1);e.setUint16(28,n.length,1);e.setUint32(42,o,1);C.push(e,n);o+=30+n.length+d.length}
 let cs=0;C.forEach(x=>cs+=x.byteLength);const E=new DataView(new ArrayBuffer(22));E.setUint32(0,0x06054b50,1);E.setUint16(8,fs.length,1);E.setUint16(10,fs.length,1);E.setUint32(12,cs,1);E.setUint32(16,o,1);return new Blob([...P,...C,E],{type:'application/zip'})}
const render=o=>{const sr=+S.xsr,T=dur()+2.5,c=new OfflineAudioContext(2,Math.ceil(T*sr),sr);build(c,0,{...o,off:1,base:0});return c.startRendering()};
async function save(name,b){const d=window.claude&&await claude.use('downloads');if(!d)return toast('Download iddoo kanatti hin jiru');try{await d.save({filename:name,data:b});toast('Fayyadameera ✔')}catch(e){toast(e.code=='declined'?'Dhiisameera':'Dogoggora: '+(e.code||e.message))}}
async function xport(stems){toast('Render gochaa jira…',9e4);try{const ext=S.fmt,enc=async b=>ext=='mp3'?await mp3(b,S.kb):wav(b,S.bits),fs=[];if(stems)for(let i=0;i<S.tr.length;i++)fs.push({n:S.tr[i].n.replace(/[^\w-]+/g,'_')+'.'+ext,b:await enc(await render({only:i,nm:1}))});else fs.push({n:'naol-mix.'+ext,b:await enc(await render({}))});await save(stems?'naol-stems.zip':'naol-mix.zip',await zip(fs))}catch(e){toast('Export dogoggora: '+(e.message||e),4000)}}
/* ---------- project save / versions (IndexedDB) ---------- */
const idb=()=>new Promise((r,j)=>{const o=indexedDB.open('naol',1);o.onupgradeneeded=()=>o.result.createObjectStore('p');o.onsuccess=()=>r(o.result);o.onerror=j}),dbx=(m,f)=>idb().then(d=>new Promise((r,j)=>{const x=f(d.transaction('p',m).objectStore('p'));x.onsuccess=()=>r(x.result);x.onerror=()=>j(x.error)}));
const ser=()=>({bpm:S.bpm,sig:S.sig,mt:S.mt,tr:S.tr.map(t=>({...t,cl:t.cl.map(c=>({st:c.st,off:c.off,dur:c.dur,fi:c.fi,fo:c.fo,m:c.m,tk:c.tk,sr:c.buf.sampleRate,d:[...Array(c.buf.numberOfChannels).keys()].map(k=>c.buf.getChannelData(k).slice())}))}))});
async function saveV(){try{await dbx('readwrite',s=>s.put(ser(),'v'+Date.now()));const k=(await dbx('readonly',s=>s.getAllKeys())).sort();for(const x of k.slice(0,-5))await dbx('readwrite',s=>s.delete(x));toast('Project guddifameera ✔');P()}catch(e){toast('Save hin danda’amne (browser hayyama dhowwateera)')}}
async function loadV(k){try{const d=await dbx('readonly',s=>s.get(k));stop();S.bpm=d.bpm;S.sig=d.sig;S.mt=d.mt;S.tr=d.tr.map(t=>({...t,cl:t.cl.map(c=>{const b=AC.createBuffer(c.d.length,c.d[0].length,c.sr);c.d.forEach((x,i)=>b.copyToChannel(x,i));return{id:uid++,buf:b,st:c.st,off:c.off,dur:c.dur,fi:c.fi,fo:c.fo,m:c.m,tk:c.tk}})}));S.sel=0;clip=null;$('#bpm').value=S.bpm;$('#sig').value=S.sig;P();toast('Project fe’ameera ✔')}catch(e){toast('Load hin danda’amne')}}
/* ---------- UI ---------- */
const sl=(l,a,b,s,v,fn,u='')=>{const d=document.createElement('label');d.className='s';d.innerHTML=`<span>${l}</span><input type="range" min="${a}" max="${b}" step="${s}" value="${v}"><b>${v}${u}</b>`;const i=d.children[1],o=d.children[2];i.oninput=()=>{o.textContent=i.value+u;fn(+i.value);upd(N)};return d},
bt=(l,fn,p)=>{const b=document.createElement('button');b.textContent=l;b.className=p?'pb p':'pb';b.onclick=fn;return b},
nt=t=>{const d=document.createElement('div');d.className='n';d.textContent=t;return d},
se=(opts,val,fn)=>{const s=document.createElement('select');s.className='q';opts.forEach((o,i)=>s.add(new Option(Array.isArray(o)?o[0]:o,i)));s.value=val;s.onchange=()=>{fn(+s.value);upd(N)};return s},
sv=(opts,val,fn)=>{const s=document.createElement('select');s.className='q';opts.forEach(o=>s.add(new Option(o,o)));s.value=val;s.onchange=()=>fn(s.value);return s};
function P(){const o=[],t=S.tr[S.sel];
 if(tab==0){S.tr.forEach((t,i)=>{const r=document.createElement('div');r.className='tr'+(i==S.sel?' sel':'');r.innerHTML=`<b>${t.n}</b><input type="range" min="0" max="1.5" step=".01" value="${t.vol}"><input type="range" min="-1" max="1" step=".01" value="${t.pan}"><button class="pb">${t.m?'🔇':'M'}</button><button class="pb">${t.so?'★':'S'}</button>`;const[nm,v,p,m,s]=r.children;nm.onclick=()=>{S.sel=i;P()};v.oninput=()=>{t.vol=+v.value;upd(N)};p.oninput=()=>{t.pan=+p.value;upd(N)};m.onclick=()=>{t.m=!t.m;upd(N);P()};s.onclick=()=>{t.so=!t.so;upd(N);P()};o.push(r)});
  o.push(nt('Volume · Pan · M = mute · S = solo. Maqaa tuqii track filadhu (⏺ track filatame irratti ni galmeessa).'),sl('Zoom',20,200,5,S.px,x=>S.px=x))}
 if(tab==1){const nm=document.createElement('input');nm.className='q';nm.value=t.n;nm.oninput=()=>t.n=nm.value;o.push(nm,sl('Volume',0,1.5,.01,t.vol,x=>t.vol=x),sl('Pan',-1,1,.01,t.pan,x=>t.pan=x),sl('EQ low',-12,12,1,t.eq[0],x=>t.eq[0]=x,'dB'),sl('EQ mid',-12,12,1,t.eq[1],x=>t.eq[1]=x,'dB'),sl('EQ high',-12,12,1,t.eq[2],x=>t.eq[2]=x,'dB'),sl('Compressor',0,10,1,t.cm,x=>t.cm=x),sl('De-esser',0,12,1,t.des,x=>t.des=x,'dB'),sl('Saturation',0,1,.05,t.sat,x=>t.sat=x),sl('Chorus/Wide',0,1,.05,t.ch,x=>t.ch=x),sl('Reverb send',0,1,.05,t.rv,x=>t.rv=x),sl('Delay send',0,1,.05,t.dl,x=>t.dl=x),
  bt('◆ Volume auto point',()=>{t.au=t.au.filter(p=>Math.abs(p.t-S.ph)>.05);t.au.push({t:S.ph,v:t.vol});toast('Automation point '+t.au.length)}),bt('Clear auto',()=>{t.au=[];toast('Haqameera')}),bt('Delete track',()=>{if(S.tr.length<2)return;S.tr.splice(S.sel,1);S.sel=0;clip=null;stop();P()}));
  const tk=t.cl.filter(c=>c.tk);if(tk.length){o.push(nt('Takes: “Use” cuqaasuun isa filatte qofa dhaga’ama.'));tk.forEach((c,k)=>o.push(bt(`Take ${k+1} · ${c.dur.toFixed(1)}s ${c.m?'':'✔'} — Use`,()=>{tk.forEach(z=>z.m=z==c?0:1);clip=c;P()})))}}
 if(tab==2){if(!clip)o.push(nt('Waveform irratti clip tuqi.'));else{const c=clip,d=c.buf.duration;o.push(sl('Start',0,Math.max(60,S.ph+60),.01,+c.st.toFixed(2),x=>c.st=x,'s'),sl('Offset',0,d-.05,.01,+c.off.toFixed(2),x=>{c.off=x;c.dur=Math.min(c.dur,d-x)},'s'),sl('Length',.05,d,.01,+c.dur.toFixed(2),x=>c.dur=Math.min(x,d-c.off),'s'),sl('Fade in',0,5,.05,c.fi,x=>c.fi=x,'s'),sl('Fade out',0,5,.05,c.fo,x=>c.fo=x,'s'),
  bt('✂ Split @playhead',split,1),bt('Copy',()=>{CB={...c};toast('Copy ✔')}),bt('Paste',()=>paste()),bt('Duplicate',()=>{CB={...c};paste(c.st+c.dur)}),bt('Snap to beat',()=>{const s=60/S.bpm;c.st=Math.round(c.st/s)*s;P()}),bt('−10ms',()=>{c.st=Math.max(0,c.st-.01);P()}),bt('+10ms',()=>{c.st+=.01;P()}),bt(c.m?'Unmute clip':'Mute clip',()=>{c.m=!c.m;P()}),bt('Delete',del),
  nt('Process (clip kana jijjiira):'),bt('Normalize',()=>pr(()=>norm(slice(c)))),sl('Tempo',50,200,1,pc,x=>pc=x,'%'),bt('Time-stretch (pitch hin jijjiiru)',()=>pr(()=>stretch(slice(c),100/pc))),sl('Pitch',-12,12,1,ps,x=>ps=x,'st'),bt('Pitch shift (tempo hin jijjiiru)',()=>pr(()=>pitchS(slice(c),ps))),sl('Threshold',-70,-20,1,th,x=>th=x,'dB'),bt('Noise gate',()=>pr(()=>clean(slice(c),th,0))),bt('Remove silence',()=>pr(()=>clean(slice(c),th,1))))}}
 if(tab==3){const m=S.mt;o.push(sl('Master bass',-12,12,1,m.lo,x=>m.lo=x,'dB'),sl('Master treble',-12,12,1,m.hi,x=>m.hi=x,'dB'),sl('Master comp',0,10,1,m.cm,x=>m.cm=x),sl('Stereo width',0,2,.05,m.wd,x=>m.wd=x),sl('Limiter ceiling',-12,0,.5,m.lim,x=>m.lim=x,'dB'),nt('Width 0 = mono, 1 = original, 2 = wide. Mono compatibility: Analyze → phase ilaali.'),nt('Reverb type · Delay time (BPM waliin) · Feedback'),se(RVT,m.rt,x=>m.rt=x),se(DV,m.dv,x=>m.dv=x),sl('Delay feedback',0,.85,.05,m.fb,x=>m.fb=x),nt('Reverb type taphachaa jirtu yeroo itti aanu play gochuun jijjiirama.'))}
 if(tab==4){const c=document.createElement('canvas');c.id='spc';c.width=300;c.height=110;c.style.cssText='width:100%;max-width:420px;background:var(--l);border-radius:8px';const i=document.createElement('div');i.id='inf';i.className='n';o.push(c,i,nt('Loudness ≈ LUFS (K-weighting hin qabu; qiyyaasa dhiyoo). Phase: +1 mono-safe, 0 bal’aa, − rakkoo.'),bt('Reference import',()=>$('#fr').click(),1),bt(S.ab?'Listening: B (reference)':'Listening: A (mix)',()=>{if(!S.ref)return toast('Duraan reference galchi');S.ab=!S.ab;upd(N);P()}),nt(S.ref?'Reference ready · Play irratti A/B jijjiiri.':'Reference hin jiru.'))}
 if(tab==5){o.push(nt('Export'),sv(['wav','mp3'],S.fmt,x=>S.fmt=x),sv(['44100','48000'],String(S.xsr),x=>S.xsr=+x),sv(['16','24'],String(S.bits),x=>S.bits=+x),sv(['128','192','320'],String(S.kb),x=>S.kb=+x),nt('Format · Sample rate · WAV bit depth · MP3 kbps. Faayilii ZIP keessatti ni kennama (viewer .wav/.mp3 kallattiin hin fudhatu).'),bt('⬇ Export mix',()=>xport(0),1),bt('⬇ Stems (track tokkoon tokkoon)',()=>xport(1)),
  sl('Latency comp',0,300,5,S.lat,x=>S.lat=x,'ms'),nt('Recording booda duubatti harkisa. Monitor: headphone fayyadami!'),bt(S.mon?'Monitor: ON':'Monitor: OFF',()=>{S.mon=!S.mon;P()}),bt('💾 Save version',saveV,1),bt('New project',()=>{if(!confirm('Project haaraa? Hojii amma jiru haqa.'))return;stop();S.tr=[mkT()];S.sel=0;clip=null;S.ref=null;P()}));
  dbx('readonly',s=>s.getAllKeys()).then(ks=>{if(tab!=5)return;ks.sort().reverse().forEach(k=>pn.append(bt('↺ '+new Date(+k.slice(1)).toLocaleString(),()=>loadV(k))))}).catch(()=>{})}
 pn.replaceChildren(...o)}
TABS.forEach((n,i)=>{const b=document.createElement('button');b.textContent=n;b.onclick=()=>{tab=i;[...$('#nav').children].forEach((x,j)=>x.className=j==i?'on':'');P()};$('#nav').append(b)});$('#nav').children[0].className='on';
$('#pl').onclick=()=>{if(playing){stop();if(rec&&rec.r.state=='recording')recStop()}else play()};$('#rw').onclick=()=>{S.ph=0;if(playing&&!rec)play(0);wr.scrollLeft=0};$('#rc').onclick=recGo;$('#pa').onclick=()=>rec&&recGo();$('#sp').onclick=()=>{recStop();stop()};
$('#bpm').onchange=e=>{S.bpm=Math.max(40,Math.min(240,+e.target.value||120));upd(N)};$('#sig').onchange=e=>S.sig=+e.target.value;$('#mt').onclick=e=>{S.met=!S.met;e.target.classList.toggle('on',!!S.met)};$('#ad').onclick=()=>{S.tr.push(mkT());S.sel=S.tr.length-1;P()};$('#im').onclick=()=>$('#fi').click();
$('#fi').onchange=e=>{imp(e.target.files);e.target.value=''};$('#fr').onchange=e=>{imp(e.target.files,1);e.target.value=''};
const peaks=b=>{if(b.pk)return b.pk;const x=b.getChannelData(0),n=Math.ceil(x.length/256),p=new Float32Array(n);for(let i=0;i<n;i++){let m=0;for(let j=i*256;j<Math.min(x.length,i*256+256);j++){const v=Math.abs(x[j]);if(v>m)m=v}p[i]=m}return b.pk=p},seek=t=>{S.ph=Math.max(0,t);if(playing&&!rec)play(S.ph)};
cv.onpointerdown=e=>{const r=cv.getBoundingClientRect(),X=e.clientX-r.left,Y=e.clientY-r.top,tm=X/S.px;if(Y<RU){seek(tm);dg={k:'s'};cv.setPointerCapture(e.pointerId);return}const i=Math.min(S.tr.length-1,Math.floor((Y-RU)/RH));if(i<0)return;S.sel=i;const c=[...S.tr[i].cl].reverse().find(c=>tm>=c.st&&tm<=c.st+c.dur);clip=c||null;if(c){dg={k:'m',o:tm-c.st};cv.setPointerCapture(e.pointerId)}P()};
cv.onpointermove=e=>{if(!dg)return;const r=cv.getBoundingClientRect(),tm=(e.clientX-r.left)/S.px;if(dg.k=='s')return seek(tm);clip.st=Math.max(0,tm-dg.o);const i=Math.max(0,Math.min(S.tr.length-1,Math.floor((e.clientY-r.top-RU)/RH))),cu=cur();if(cu&&S.tr[i]!==cu){cu.cl.splice(cu.cl.indexOf(clip),1);S.tr[i].cl.push(clip);S.sel=i}};
cv.onpointerup=cv.onpointercancel=()=>{if(dg&&dg.k=='m')P();dg=null};
function draw(){const W=wr.clientWidth,H=RU+RH*S.tr.length+4,w=Math.min(30000,Math.max(W,(dur()+6)*S.px));if(cv.width!=w)cv.width=w;if(cv.height!=H)cv.height=H;cv.style.width=w+'px';const cs=getComputedStyle(document.documentElement),A=cs.getPropertyValue('--a'),Lc=cs.getPropertyValue('--l'),Mc=cs.getPropertyValue('--m'),Tc=cs.getPropertyValue('--t');
 q.clearRect(0,0,w,H);q.font='10px system-ui';q.lineWidth=1;const spb=60/S.bpm;q.strokeStyle=Lc;q.fillStyle=Mc;for(let k=0;k*spb*S.px<w;k++){const X=k*spb*S.px,bar=k%S.sig==0;q.globalAlpha=bar?.9:.35;q.beginPath();q.moveTo(X,bar?0:RU-5);q.lineTo(X,H);q.stroke();if(bar)q.fillText(k/S.sig+1,X+3,11)}q.globalAlpha=1;
 S.tr.forEach((t,i)=>{const y=RU+i*RH;if(i==S.sel){q.fillStyle=Lc;q.globalAlpha=.4;q.fillRect(0,y,w,RH);q.globalAlpha=1}
  t.cl.forEach(c=>{const X=c.st*S.px,cw=Math.max(2,c.dur*S.px);q.fillStyle=A;q.globalAlpha=c.m?.1:.25;q.fillRect(X,y+3,cw,RH-6);q.globalAlpha=c.m?.3:1;if(c==clip){q.strokeStyle=Tc;q.strokeRect(X,y+3,cw,RH-6)}
   const pk=peaks(c.buf),sr=c.buf.sampleRate/256,mid=y+RH/2,p0=Math.max(0,Math.floor(wr.scrollLeft-X)),p1=Math.min(cw,wr.scrollLeft+W-X);q.fillStyle=A;for(let p=p0;p<p1;p++){const a=Math.floor((c.off+p/S.px)*sr),e=Math.max(a+1,Math.floor((c.off+(p+1)/S.px)*sr));let m=0;for(let j=a;j<e&&j<pk.length;j++)if(pk[j]>m)m=pk[j];const h=m*(RH-10)/2;q.fillRect(X+p,mid-h,1,Math.max(1,2*h))}q.globalAlpha=1});
  q.fillStyle=Tc;q.fillText(t.n+(t.m?' (M)':'')+(t.so?' (S)':''),4+wr.scrollLeft,y+12)});
 q.fillStyle=Tc;q.fillRect(S.ph*S.px-1,0,2,H)}
function meters(){let pk=0;if(rec){rec.an.getFloatTimeDomainData(rec.fl);for(const v of rec.fl)pk=Math.max(pk,Math.abs(v))}else if(N&&N.aL){N.aL.getFloatTimeDomainData(N.fl);N.aR.getFloatTimeDomainData(N.fr);let ss=0,ll=0,rr=0,lr=0;for(let i=0;i<1024;i++){const l=N.fl[i],r=N.fr[i];pk=Math.max(pk,Math.abs(l),Math.abs(r));ss+=l*l+r*r;ll+=l*l;rr+=r*r;lr+=l*r}ls=ls*.97+ss/2048*.03;N.cor=lr/Math.sqrt(ll*rr+1e-12);pkMax=Math.max(pkMax,pk)}
 const now=performance.now();if(pk>.97)hold=now;const cl=now-hold<1200;$('#lvb').style.width=Math.min(100,pk*100)+'%';$('#lvb').style.background=cl?'var(--r)':'var(--a)';$('#lvt').textContent=cl?'⚠ CLIP — sagalee gadi buusi':(pk>1e-4?(20*Math.log10(pk)).toFixed(1)+' dB':'');
 const c2=$('#spc');if(c2){const k=c2.getContext('2d');k.clearRect(0,0,300,110);if(N&&N.an){N.an.getByteFrequencyData(N.fb);k.fillStyle=getComputedStyle(document.documentElement).getPropertyValue('--a');for(let i=0;i<75;i++){const j=Math.floor(Math.pow(i/75,2.2)*N.fb.length*.9)+1,h=N.fb[j]/255*105;k.fillRect(i*4,110-h,3,h)}}
  $('#inf').textContent=`≈ ${(-.691+10*Math.log10(ls+1e-10)).toFixed(1)} LUFS · peak ${(20*Math.log10(pkMax+1e-9)).toFixed(1)} dB · phase ${N&&N.cor!=null?N.cor.toFixed(2)+(N.cor<0?' ⚠':''):'–'}`}}
function loop(){if(playing){S.ph=Math.max(t0,t0+AC.currentTime-tAt);if(S.ph>=dur()+2&&!rec){stop();S.ph=0}else if(rec&&rec.r.state!='recording'){}
  const x=S.ph*S.px;if(x>wr.scrollLeft+wr.clientWidth*.85||x<wr.scrollLeft)wr.scrollLeft=x-wr.clientWidth*.15}
 $('#tm').textContent=fmt(S.ph);draw();meters();requestAnimationFrame(loop)}
P();loop();
</script></body></html>
